--label:光効果
--select@mode: モード,レイヤーにグロー効果=0, フレームバッファにレイヤーのグローを合成=1
--track@radius:半径,0,50,7.0,0.1
--track@angle:角度,-360,360,0,0.1
--track@exposure:露出_マスク,0,100,25.0,0.1
--track@middleGrey:露出_全体,0,100,50.0,0.1
--track@threshold:マスク,0,100,30,0.1
--track@smoothness:マスクの滑らかさ,0,100,20,0.1
--track@bias:彩度の影響,-100,100,0,0.1
--group@クロスブラー
--track@radius_cross:半径_クロスブラー,0,500,1,1
--track@biim:光条数,1,16,4,1
--track@strength:コントラスト,0,10,1,0.01;
--track@angle_All:全体角度,0,360,360,0.1
--track@gamma:光の急峻さ,0.2,3,2.3,0.01
--track@radius_core:中心部分強度,0,20,0,0.1;
--group@トーンマップ
--track@MappingMode:元画像の明度で減量,0.0, 2.0, 0.0, 0.01;
--track@glowStrength:合成調整_グロー強度,0.5,9,2.00,0.01
--track@MappingBlend:トーンマップ1,0,100,10,0.1;
--track@MappingBlend2:トーンマップ2,0,100,10,0.1;
--group@光の色
--color@col:光の色,0xffffff
--track@hueShift:色相_時間制御用,-360,360,0,0.1
--track@saturateShift:彩度_時間制御用,-100,100,0,0.1
--filter

--閾値
--[[pixelshader@MaskFilter:
Texture2D tempbuffer : register(t0);
SamplerState sampler0 : register(s0);
cbuffer constant0 : register(b0){
    float exposure; //NEW トーンマッピング用　上げ過ぎると明るすぎる
    float threshold;
    float smoothness;
    float gamma;
    float bias;
    float r; float g; float b;
};

float3 HableCurve(float3 x){
    const float A = 0.15; // Shoulder Strength
    const float B = 0.50; // Linear Strength
    const float C = 0.10; // Linear Angle
    const float D = 0.20; // Toe Strength
    const float E = 0.02; // Toe Numerator
    const float F = 0.30; // Toe Denominator
    return ((x*(A*x+C*B)+D*E) / (x*(A*x+B)+D*F)) - E/F;
}

float3 ToneMap(float3 color, float whitePoint){
    float3 mapped = HableCurve(max(color,0.0));
    float3 white = HableCurve(float3(whitePoint,whitePoint,whitePoint));
    return mapped / white;
}


float4 MaskFilter(float4 pos : SV_Position, float2 uv : TEXCOORD): SV_Target{
    float4 rgba = tempbuffer.Sample(sampler0,uv);
    float lum = dot(rgba.rgb, float3(0.2126, 0.7152, 0.0722));
    float maxC = max(rgba.r,max(rgba.b, rgba.g));
    float minC = min(rgba.r,min(rgba.g, rgba.b));
    float sat = maxC - minC;

    float satBias = bias / 100;
    float score = lerp(lum, sat, clamp(satBias * 0.5 + 0.5, 0.0, 1.0));

    float k = smoothstep(threshold - smoothness, threshold + smoothness, score);
    float glowStrength = exp(k * gamma ) - 1.0;

    float3 hdr = rgba.rgb * glowStrength;
    float3 exposed = hdr * exposure;

    float3 col = float3(r,g,b);
    float3 result = exposed * col;
    return float4(result*rgba.a, rgba.a);
}
]]

--ブラー
--[[pixelshader@CauchyBlur:
Texture2D tempbuffer : register(t0);
SamplerState sampler0 : register(s0);
cbuffer constant0 : register(b0){
    float radius;
    float angle;
};
float4 CauchyBlur(float4 pos : SV_Position): SV_Target{
    uint w,h;
    tempbuffer.GetDimensions(w,h);
    float2 texelSize = float2(1.0/w, 1.0/h);
    float2 uv = pos.xy * texelSize;

    float4 result =  float4(0,0,0,0);

    int samples = (int)(radius * 6.0);
    samples = clamp(samples, (int)32, (int)256);
    float pi = 3.1415926;
    float rad = angle / 180 * pi;

    float totalW = 0.0;
    if(radius == 0)return tempbuffer.Sample(sampler0, uv);
    for(int i = (-1 * samples); i <= samples; i++){
        float2 offset = float2(
            i * texelSize.x * cos(rad), 
            i * sin(rad) * texelSize.y
            );
        float2 sampleUV = uv + offset;
        float inside = (all(sampleUV >= 0.0) && all(sampleUV <= 1.0)) ? 1.0 : 0.0;
        float dist = abs(float(i))/radius;
        float weight = 1.0 / (dist * dist + 1.0)*inside;
        result += tempbuffer.Sample(sampler0, sampleUV) * weight;
        totalW += weight;
    }
    result /= totalW;
    return result;

}
]]

--クロスブラー
--[[pixelshader@CauchyCrossBlur:
Texture2D tempbuffer : register(t0);
SamplerState sampler0 : register(s0);
cbuffer constant0 : register(b0){
    float radius_cross;
    float angle; //角度はコーシーブラーのものと共有
    float biim; 
    float strength;
    float angle_All;
    float radius_core;
};
float4 CauchyCrossBlur(float4 pos : SV_Position): SV_Target{
    uint w, h;
    tempbuffer.GetDimensions(w,h);
    float2 texelSize = float2(1.0/w, 1.0/h);
    float2 uv = pos.xy * texelSize;
    float4 result = float4(0,0,0,0);

    int samples = (int)(radius_cross * 6.0);
    samples = clamp(samples, (int)32, (int)256);
    float pi = 3.1415926;
    float rad = angle / 180 * pi;

    float totalW = 0.0;

    float angle_rad = radians(angle);
    float angle_plus = (biim > 1) ? radians(angle_All / biim) : 0.0;
    if(radius_cross == 0)return tempbuffer.Sample(sampler0, uv);
    for(int i = 0; i < biim; i++){
        for(int x = 0; x< radius_cross; x++){
            float2 offset = float2(
                x * texelSize.x * cos(angle_rad + angle_plus * i),
                x * sin(angle_rad + angle_plus * i) * texelSize.y
            );
            float2 sampleUV = uv + offset;
            float inside = (all(sampleUV >= 0.0) && all(sampleUV <= 1.0)) ? 1.0 : 0.0;
            float dist = abs(float(x))/radius_cross;
            float weight = 1.0 / (dist * dist + 1.0) * (1.0 - dist * dist);
            float4 sampleCol = tempbuffer.Sample(sampler0, sampleUV) * weight * inside;
            result = max(sampleCol, result);
        }
    }
    float4 sampleMax = float4(0,0,0,0);
    if(radius_core > 0){
        for(int x = -radius_core; x < radius_core; x++){
            for(int y = -radius_core; y < radius_core; y++){
                if(length(float2(x, y)) <= radius_core){
                    float2 offset = float2(
                        x * texelSize.x,
                        y * texelSize.y
                    );
                    float2 sampleUV = uv + offset;
                    float4 sampleCol = tempbuffer.Sample(sampler0, saturate(sampleUV));
                    sampleMax = max(sampleCol, sampleMax);
                }
            }
        }
        float4 resultCore = sampleMax * radius_core / 5.0;
        result = 1.0 - (1.0 - result) * (1.0 - resultCore);
    }
    result.rgb *= (1 + strength / 10);

    return result;
}
]]

--合算とそれに伴う色調補正
--[[pixelshader@ToneMapping:

Texture2D origin : register(t0);
Texture2D blurred : register(t1);
Texture2D OriginColorAve : register(t2);
Texture2D BlurredColorAve : register(t3);

SamplerState sampler0 : register(s0);
cbuffer constant0 : register(b0){
    float glowStrength;
    float middleGrey;
    float MappingBlend;
    float MappingBlend2;
    float MappingMode;
};
float Luminance(float3 color){
    return dot(color, float3(0.2126, 0.7152, 0.0722));
}

//Hable式トーンマッピング
float3 HableCurve(float3 x){
    const float A = 0.15; // Shoulder Strength
    const float B = 0.50; // Linear Strength
    const float C = 0.10; // Linear Angle
    const float D = 0.20; // Toe Strength
    const float E = 0.02; // Toe Numerator
    const float F = 0.30; // Toe Denominator
    return ((x*(A*x+C*B)+D*E) / (x*(A*x+B)+D*F)) - E/F;
}

//余裕があれば他のカーブも入れたい
float3 ToneMap(float3 color, float whitePoint, float blend){
    
        float3 mapped = HableCurve(color);
        float3 white =  HableCurve(float3(whitePoint,whitePoint,whitePoint));
        float3 result = mapped / white;
        return lerp(color, result, blend);   
}
float3 ToneMap2(float3 color,float whitePoint, float blend){
        float lum_origin = dot(color, float3(0.2126, 0.7152, 0.0722));
        float lum = lum_origin * (11.2/2.0);
        const float A = 0.15; // Shoulder Strength
        const float B = 0.50; // Linear Strength
        const float C = 0.10; // Linear Angle
        const float D = 0.20; // Toe Strength
        const float E = 0.02; // Toe Numerator
        const float F = 0.30; // Toe Denominator
        float mappedLum = ((lum*(A*lum+C*B)+D*E) / (lum*(A*lum+B)+D*F)) - E/F;
        float whiteScale = ((whitePoint*(A*whitePoint+C*B)+D*E) / (whitePoint*(A*whitePoint+B)+D*F)) - E/F;
        float3 result = color *(mappedLum / whiteScale);
        return lerp(color,result, blend);
}
float4 ToneMapping(float4 pos : SV_Position): SV_Target{
    uint w, h;
    origin.GetDimensions(w,h);
    float2 texelSize = float2(1.0/w, 1.0/h);
    float2 uv = pos.xy * texelSize;
    float4 Origin = origin.Sample(sampler0,uv);
    float4 Glow = blurred.Sample(sampler0, uv);
    float4 AveOrigin = OriginColorAve.Sample(sampler0,uv);
    float4 AveGlow = BlurredColorAve.Sample(sampler0,uv);

    float whitePoint = 11.2;

//グローを合成　モードで加算とスクリーンを切り替える
    float4 hdr;
    if (MappingMode<1)hdr = Origin + Glow * glowStrength * max((1 - Origin*MappingMode),0);
    else hdr = float4(Origin + Glow * glowStrength * pow(max((1 - Origin),0),MappingMode));

//シーン全体の輝度を測る
    float avgLumSrc = Luminance(AveOrigin.rgb);
    float avgLumGlow = Luminance(AveGlow.rgb);
    float avgLum = avgLumSrc + avgLumGlow;
    avgLum = max(avgLum, 0.0001);

//露出補正　Reinhard式キー値
    float exposure = middleGrey / avgLum;
    float3 exposed = hdr.rgb * exposure;
    float3 tonemapped = ToneMap(exposed, whitePoint, MappingBlend);
    float3 tonemapped2 = ToneMap2(tonemapped,whitePoint, MappingBlend2);

    return float4(tonemapped2,saturate(hdr.a));
}
]]
-- RGB → HSV
local function RGBtoHSV(r, g, b)
    r, g, b = r/255, g/255, b/255
    local max = math.max(r, g, b)
    local min = math.min(r, g, b)
    local delta = max - min

    local h, s, v
    v = max

    if max == 0 then
        s = 0
    else
        s = delta / max
    end

    if delta == 0 then
        h = 0
    elseif max == r then
        h = (g - b) / delta % 6
    elseif max == g then
        h = (b - r) / delta + 2
    else
        h = (r - g) / delta + 4
    end

    h = h * 60 -- 0〜360に変換

    return h, s, v
end

-- HSV → RGB
local function HSVtoRGB(h, s, v)
    if s == 0 then
        local val = math.floor(v * 255)
        return val, val, val
    end

    h = h / 60
    local i = math.floor(h)
    local f = h - i
    local p = v * (1 - s)
    local q = v * (1 - s * f)
    local t = v * (1 - s * (1 - f))

    local r, g, b
    if     i == 0 then r, g, b = v, t, p
    elseif i == 1 then r, g, b = q, v, p
    elseif i == 2 then r, g, b = p, v, t
    elseif i == 3 then r, g, b = p, q, v
    elseif i == 4 then r, g, b = t, p, v
    else               r, g, b = v, p, q
    end

    return math.floor(r*255), math.floor(g*255), math.floor(b*255)
end

local r, g, b = RGB(col)

--色相変化
local h, s, v = RGBtoHSV(r, g, b)
h = (h + hueShift) % 360  -- hueShiftを外部パラメータで渡す
--彩度変化
s = s + (saturateShift / 100);
s = math.max(0, math.min(1, s + saturateShift / 100))
r, g, b = HSVtoRGB(h, s, v)

obj.effect("オフスクリーン描画")
obj.copybuffer("cache:original","object") --cache:original::元画像
obj.copybuffer("tempbuffer","cache:original")
obj.pixelshader("MaskFilter","object",{"object"},{exposure / 100,threshold / 100,smoothness / 100,gamma,bias,r/255,g/255,b/255},"copy","clip")
obj.effect("リサイズ","拡大率",50)
obj.copybuffer("tempbuffer","object")
obj.pixelshader("CauchyBlur","object",{"object"},{radius,angle},"copy","clip")
obj.copybuffer("tempbuffer","object")
obj.pixelshader("CauchyBlur","object",{"object"},{radius, angle + 60},"copy","clip")
obj.copybuffer("tempbuffer","object")
obj.pixelshader("CauchyBlur","object",{"object"},{radius, angle - 60},"copy","clip")
obj.copybuffer("tempbuffer","object")
obj.pixelshader("CauchyCrossBlur","object",{"object"},{radius_cross, angle, biim, strength, angle_All, radius_core},"copy","clamp")
obj.effect("リサイズ","拡大率",200)

obj.copybuffer("cache:blurred","object") --cache:blurred::閾値処理後のぼかしが終わった後

if mode == 0 then
    obj.copybuffer("object","cache:original")  --全体の輝度を測定するために元画像を呼び出す
    local w = obj.w
    local h = obj.h
    obj.effect("リサイズ","拡大率",1,"ピクセル数でサイズ指定",1)
    obj.effect("リサイズ","拡大率",h,"X",w/h*100.0, "ピクセル数でサイズ指定",1)
    obj.copybuffer("cache:OriginColorAve","object") --cache:OriginColorAve::元画像の色の平均
    obj.copybuffer("object","cache:blurred") --同様にブラー後の画像でも平均化する
    obj.effect("リサイズ","拡大率",1,"ピクセル数でサイズ指定",1)
    obj.effect("リサイズ","拡大率",h,"X",w/h*100.0, "ピクセル数でサイズ指定",1)
    obj.copybuffer("cache:BlurredColorAve","object") --cache:BlurredColorAve::加算画像の色の平均
    obj.copybuffer("object","cache:original")
    obj.pixelshader("ToneMapping","object",{"cache:original","cache:blurred","cache:OriginColorAve","cache:BlurredColorAve"},{glowStrength, middleGrey/100,MappingBlend/100, MappingBlend2/100, MappingMode} ,"copy","clamp")

elseif mode == 1 then
    obj.load("framebuffer")
    local w = obj.w;
    local h = obj.h;
    obj.effect("リサイズ","拡大率",1,"ピクセル数でサイズ指定",1)
    obj.effect("リサイズ","拡大率",h,"X",w/h*100.0, "ピクセル数でサイズ指定",1)
    obj.copybuffer("cache:framebufferColorAve","object") --cache:OriginColorAve::元画像の色の平均
    obj.copybuffer("object","cache:blurred") --同様にブラー後の画像でも平均化する
    obj.effect("リサイズ","拡大率",1,"ピクセル数でサイズ指定",1)
    obj.effect("リサイズ","拡大率",h,"X",w/h*100.0, "ピクセル数でサイズ指定",1)
    obj.copybuffer("cache:BlurredColorAve","object") --cache:BlurredColorAve::加算画像の色の平均
    obj.load("framebuffer")
    obj.pixelshader("ToneMapping","object",{"object","cache:blurred","cache:framebufferColorAve","cache:BlurredColorAve"},{glowStrength, middleGrey/100,MappingBlend/100, MappingBlend2/100, MappingMode} ,"copy","clamp")
end
